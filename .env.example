# Constans configuration. Copy to .env (docker compose reads it) or export these in your service manager.
# Only the first section is required to get going; the rest are opt-in.

# ─── Required for a production install ───────────────────────────────────────────────────────────
# Environment: development | staging | production. Production applies the strictest publishing gates.
CONSTANS_ENV=production

# The first administrator, created on first start. Choose a long password; you will be asked to change it.
CONSTANS_ADMIN_EMAIL=admin@example.com
CONSTANS_ADMIN_PASSWORD=

# Encrypts stored secrets (AES-256-GCM). Generate one:  openssl rand -base64 32
# If you leave this empty a key is generated into the data volume — fine for a trial, but in production
# supply it from a secret manager and keep a copy OFF this host: without it, backups cannot decrypt secrets.
CONSTANS_MASTER_KEY=
# Old key(s) kept readable while you rotate (comma separated). Then: constans admin rotate-master-key
CONSTANS_PREVIOUS_MASTER_KEYS=

# The URL people use in their browser. https:// marks session cookies Secure.
CONSTANS_PUBLIC_URL=http://localhost:8080
# Set to true when a reverse proxy sets X-Forwarded-For (so rate limits and the audit log see real client IPs).
CONSTANS_TRUST_PROXY=false

# ─── Server ─────────────────────────────────────────────────────────────────────────────────────
CONSTANS_PORT=8080
CONSTANS_HOST=0.0.0.0
# Where the database, artifacts and generated master key live. (The container sets /data.)
# CONSTANS_DATA_DIR=./data
# docker compose only: which host address to publish on. Keep 127.0.0.1 behind a proxy.
CONSTANS_BIND=127.0.0.1
CONSTANS_LOG_LEVEL=info
# Bearer token that protects GET /metrics (Prometheus). Unset = metrics are not exposed.
CONSTANS_METRICS_TOKEN=
CONSTANS_SESSION_TTL_HOURS=12
CONSTANS_RATE_LIMIT_PER_MIN=600
# docker compose --profile tls: the public hostname Caddy should get a certificate for.
CONSTANS_DOMAIN=

# ─── Governance ─────────────────────────────────────────────────────────────────────────────────
# How many people must approve a risky production publish.
CONSTANS_PUBLISH_APPROVALS=1
# Publish the shipped example workflows on first start, from this directory (the container sets /app/workflows).
CONSTANS_SEED_EXAMPLES=false
# CONSTANS_WORKFLOWS_DIR=./workflows
# Directory of operator policy documents (kind: Policy). See policies/examples/.
# CONSTANS_POLICY_DIR=/etc/constans/policies

# ─── Capacity ───────────────────────────────────────────────────────────────────────────────────
CONSTANS_MAX_CONCURRENT_RUNS=16
CONSTANS_MAX_CONCURRENT_STEPS=32

# ─── Integrations (all opt-in; a capability is only available when its config is present) ───────
# Chat/webhook channels for the notify-channel capability and for alerts. name → webhook URL.
# Prefix with slack: | teams: | discord: | generic: when the format is not Slack-style.
# CONSTANS_CHANNELS={"ops":"https://hooks.slack.com/services/T000/B000/XXXX"}
# Which channels receive alerts (must be defined above).
# CONSTANS_ALERT_CHANNELS=ops
# How often the Analysis Agent reviews run history (hours; 0 disables) and alerts are evaluated (seconds).
CONSTANS_ANALYSIS_INTERVAL_HOURS=24
CONSTANS_ALERT_INTERVAL_SECONDS=60

# Databases for database-query / database-command. name → URL (postgres://… or sqlite:///path).
# CONSTANS_DATASOURCES={"warehouse":"postgres://user:pass@db:5432/warehouse"}

# Email through SMTP for notify-email.
# CONSTANS_SMTP_URL=smtps://user:pass@smtp.example.com:465
# CONSTANS_SMTP_FROM=constans@example.com

# AI authoring (Planner, script importer) and the llm-inference capability.
# CONSTANS_LLM_API_KEY=            # or ANTHROPIC_API_KEY
# CONSTANS_LLM_MODEL=claude-sonnet-5
# CONSTANS_LLM_BASE_URL=https://api.anthropic.com

# Files: file-read / file-write / file-list / file-delete are confined to this directory.
# CONSTANS_STORAGE_DIR=/data/files

# ─── Sharp edges ────────────────────────────────────────────────────────────────────────────────
# Shell steps: comma-separated ABSOLUTE paths of executables shell-exec may run. Empty = disabled.
# Isolation relies on the container: run with no network access to anything sensitive.
# CONSTANS_SHELL_ALLOWED_COMMANDS=/usr/bin/curl,/opt/constans/scripts/nightly.sh
# Let allow-listed hosts resolve to private addresses (needed for docker-compose service names / on-prem APIs).
# CONSTANS_ALLOW_PRIVATE_EGRESS=false

# --- NEXORA integration (optional; leave unset for a normal install) ----------------------------
# CONSTANS_MODE=nexora runs Constans as a NEXORA tenant product. Until NEXORA publishes its contracts the only
# Core is `fake` (unsigned, development and staging only; refused when CONSTANS_ENV=production).
# CONSTANS_MODE=standalone
# CONSTANS_NEXORA_CORE=fake
# Lifetime of a session created by NEXORA sign-in (minutes, 1-60), and the cookie that carries the identity assertion.
# CONSTANS_NEXORA_SESSION_TTL_MINUTES=5
# CONSTANS_NEXORA_ASSERTION_COOKIE=__session
