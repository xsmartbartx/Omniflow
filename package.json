{
  "name": "omniflow",
  "version": "1.0.0",
  "description": "OmniFlow — AI workflow substrate: declarative, deterministic, auditable workflow engine with an AI authoring plane.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "console",
    "workflows",
    "policies/examples",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "omniflow": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "site": "node --disable-warning=ExperimentalWarning scripts/serve-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check:layers": "node scripts/check-layers.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:layers && npm run test",
    "format:check": "biome format .",
    "licenses": "node scripts/third-party.mjs",
    "docs:generate": "node --disable-warning=ExperimentalWarning scripts/emit-docs.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "semver": "^7.8.5",
    "undici": "^8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
